<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>MiniBridge Password AutoFill</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>MiniBridge Password AutoFill</string>
    <key>CFBundlePackageType</key><string>XPC!</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSFaceIDUsageDescription</key><string>验证身份后安全读取加密密码库。</string>
    <key>MBSharedKeychainGroup</key><string>$(AppIdentifierPrefix)com.minibridge.passwords.shared</string>
    <key>NSExtension</key><dict>
        <key>NSExtensionAttributes</key><dict>
            <key>ASCredentialProviderExtensionCapabilities</key><dict>
                <key>ProvidesCredentialWithoutUserInteraction</key><false/>
                <key>ShowsConfigurationUI</key><true/>
                <key>SupportsSavePasswordCredentials</key><true/>
            </dict>
        </dict>
        <key>NSExtensionPointIdentifier</key><string>com.apple.authentication-services-credential-provider-ui</string>
        <key>NSExtensionPrincipalClass</key><string>$(PRODUCT_MODULE_NAME).CredentialProviderViewController</string>
    </dict>
</dict></plist>
